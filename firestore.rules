rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Only authenticated users can access data
    // 2. Users can only read and write data in their own specific user document (users/{uid})
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 3. All other access is denied by default (Firebase implicitly denies anything not explicitly allowed)
  }
}
